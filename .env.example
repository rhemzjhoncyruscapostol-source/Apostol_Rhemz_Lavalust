# Copy this file to .env and fill in the values. NEVER commit .env.

APP_NAME=Lavalust
# Use "production" on Render
APP_ENV=development

# Aiven MySQL (Aiven console > your service > Connection information)
DB_HOST=your-service.i.aivencloud.com
DB_PORT=12345
DB_USERNAME=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb

# API security - generate each with:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Frontend URL allowed to call the API (use * only for local testing)
ALLOWED_ORIGIN=http://localhost:5173
